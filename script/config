#!/usr/bin/env zsh
set -euo pipefail

root="${0:A:h:h}"
self="${0:A}"
config="$root/config.json"
skill_file="$root/skill/SKILL.md"
chain_args=()
adapter_rows=()
dex_rows=()
coverage_rows=()
runtime_rows=()
oracle_config="${SPOT_ORACLE_CONFIG_JSON:-}"
issue_rows=()
supported_order=()
typeset -A supported_chains
typeset -A chain_keys
typeset -A code_cache
code_state_result=""

usage() {
  print 'Usage: script/config [CHAIN_ID|* ...]'
  print
  print 'Options:'
  print '  -h, --help     Show this help message.'
  print
  print 'CHAIN_ID defaults to *; quote "*" to check the union of Spot config, skill, and oracle chains.'
}

die() {
  print -u2 "error: $*"
  exit 1
}

parse_args() {
  while (( $# > 0 )); do
    case $1 in
      -h|--help)
        usage
        exit 0
        ;;
      --)
        shift
        chain_args+=("$@")
        break
        ;;
      --*)
        die "unknown option: $1"
        ;;
      *)
        chain_args+=("$1")
        shift
        ;;
    esac
  done
}

load_supported_chains() {
  local chain_id
  while IFS= read -r chain_id; do
    [[ -n $chain_id ]] || continue
    supported_order+=("$chain_id")
    supported_chains[$chain_id]=1
  done < <(
    awk '
      /^## Supported Chains[[:space:]]*$/ {
        capture = 1
        next
      }
      capture && /^## / {
        exit
      }
      capture && /^[0-9]+[.][[:space:]]/ {
        if (!match($0, /`[0-9]+`/)) {
          next
        }
        print substr($0, RSTART + 1, RLENGTH - 2)
      }
    ' "$skill_file"
  )
}

load_chain_keys() {
  local chain_id chain_key
  command -v getchain >/dev/null 2>&1 || return 0

  while IFS=$'\t' read -r chain_id chain_key; do
    [[ -n $chain_id && -n $chain_key ]] || continue
    [[ -n ${chain_keys[$chain_id]-} ]] && continue
    chain_keys[$chain_id]=$chain_key
  done < <(
    getchain -a -j | jq -r '
      to_entries[]
      | select(.value.id != null)
      | [(.value.id | tostring), .key]
      | @tsv
    '
  )
}

selected_chains() {
  local -A seen=()
  local -a selected=()
  local arg chain_id

  (( ${#chain_args[@]} > 0 )) || chain_args=("*")

  for arg in "${chain_args[@]}"; do
    if [[ $arg == "*" ]]; then
      for chain_id in "${supported_order[@]}" "${(@f)$(jq -r 'keys[] | select(. != "*")' "$config")}" "${(@f)$(print -r -- "$oracle_config" | jq -r 'keys[]')}"; do
        [[ -z ${seen[$chain_id]-} ]] || continue
        selected+=("$chain_id")
        seen[$chain_id]=1
      done
      continue
    fi

    [[ -z ${seen[$arg]-} ]] || continue
    selected+=("$arg")
    seen[$arg]=1
  done

  printf '%s\n' "${selected[@]}"
}

print_table() {
  node "$root/script/table.mjs"
}

configured_addresses() {
  local chain_id=$1
  jq -r --arg chain "$chain_id" '
    . as $cfg
    |
    def merged_dex: (($cfg["*"].dex // {}) + ($cfg[$chain].dex // {}));
    def required_address_fields($dex):
      ($dex.value.type // "") as $type
      | if $type == "default" or $type == "paraswap" then
          ["router", "adapter", "fee"]
        elif $type == "p2" then
          ["router", "permit2", "adapter", "fee"]
        elif $type == "dynamicp2" then
          ["permit2", "adapter", "fee"]
        elif $type == "universal" then
          ["adapter", "fee"]
        else
          []
        end;

    (
      (($cfg["*"].adapter // {}) + ($cfg[$chain].adapter // {}))
      | to_entries[]
      | select(((.value // "") | tostring | length) > 0)
      | ["adapter", .key, .value]
      | @tsv
    ),
    (
      merged_dex
      | to_entries[]
      | . as $dex
      | required_address_fields($dex)[]
      | . as $field
      | ($dex.value[$field] // "") as $addr
      | select(($addr | tostring | length) > 0)
      | ["dex", ($dex.key + "." + $field), $addr]
      | @tsv
    )
  ' "$config"
}

dex_configs() {
  local chain_id=$1
  jq -r --arg chain "$chain_id" '
    . as $cfg
    |
    def merged_dex: (($cfg["*"].dex // {}) + ($cfg[$chain].dex // {}));
    def required_fields($dex):
      ($dex.value.type // "") as $type
      | if $type == "default" or $type == "paraswap" then
          ["solver", "router", "adapter", "fee"]
        elif $type == "p2" then
          ["solver", "router", "permit2", "adapter", "fee"]
        elif $type == "dynamicp2" then
          ["solver", "permit2", "adapter", "fee"]
        elif $type == "universal" then
          ["adapter", "fee"]
        else
          []
        end;
    def address_fields($dex):
      ($dex.value.type // "") as $type
      | if $type == "default" or $type == "paraswap" then
          ["router", "adapter", "fee"]
        elif $type == "p2" then
          ["router", "permit2", "adapter", "fee"]
        elif $type == "dynamicp2" then
          ["permit2", "adapter", "fee"]
        elif $type == "universal" then
          ["adapter", "fee"]
        else
          []
        end;
    def known_types: ["default", "paraswap", "p2", "dynamicp2", "universal"];

    merged_dex
    | to_entries[]
    | . as $dex
    | ($dex.value.type // "") as $type
    | if (known_types | index($type)) then
        (required_fields($dex) | map(select((($dex.value[.] // "") | tostring | length) == 0))) as $missing
        | [
            $dex.key,
            $type,
            ($dex.value.solver // "-"),
            (if ($missing | length) == 0 then "ok" else "missing " + ($missing | join(",")) end),
            (address_fields($dex)
              | map(select((($dex.value[.] // "") | tostring | length) > 0))
              | map(. + "=" + ($dex.value[.] | tostring))
              | join(";"))
          ]
      else
        [$dex.key, ($type | tostring), ($dex.value.solver // "-"), ("bad type " + ($type | tostring)), ""]
      end
    | @tsv
  ' "$config"
}

adapter_configs() {
  local chain_id=$1
  jq -r --arg chain "$chain_id" '
    ((.["*"].adapter // {}) + (.[$chain].adapter // {}))
    | to_entries[]
    | select(((.value // "") | tostring | length) > 0)
    | [.key, .value]
    | @tsv
  ' "$config"
}

add_issue() {
  local chain_id=$1 target=$2 detail=$3
  issue_rows+=("${chain_keys[$chain_id]:-$chain_id}"$'\t'"${target}"$'\t'"${detail}")
}

code_state() {
  local chain_id=$1 address=$2
  local cache_key="${chain_id}:${address:l}"
  local code probe_result

  if [[ -n ${code_cache[$cache_key]-} ]]; then
    code_state_result=${code_cache[$cache_key]}
    return 0
  fi

  if [[ ! $address =~ ^0x[[:xdigit:]]{40}$ || $address == 0x0000000000000000000000000000000000000000 ]]; then
    probe_result=invalid
  elif ! code=$(cast code "$address" --rpc-timeout 15 2>/dev/null); then
    probe_result=rpc-error
  elif [[ -z $code || $code == "0x" ]]; then
    probe_result=missing
  else
    probe_result=ok
  fi

  code_cache[$cache_key]=$probe_result
  code_state_result=$probe_result
}

shared_dex_missing() {
  local chain_id=$1 dex=$2 address
  jq -e --arg id "$chain_id" --arg dex "$dex" '.[$id].dex // {} | has($dex)' "$config" >/dev/null && return 1
  address=$(jq -r --arg dex "$dex" '.["*"].dex[$dex].adapter // "-"' "$config")
  code_state "$chain_id" "$address"
  [[ $code_state_result == missing ]]
}

probe_chain() {
  local chain_id=$1
  local group target address probe_result

  while IFS=$'\t' read -r group target address; do
    [[ -n $group && -n $address ]] || continue

    case $group in
      adapter|dex) ;;
      *) continue ;;
    esac

    if [[ $group == dex ]] && shared_dex_missing "$chain_id" "${target%%.*}"; then
      continue
    fi

    code_state "$chain_id" "$address"
    probe_result=$code_state_result
    if [[ $group == adapter && $probe_result == missing ]] && ! jq -e --arg id "$chain_id" --arg name "$target" '.[$id].adapter // {} | has($name)' "$config" >/dev/null; then
      continue
    fi
    if [[ $probe_result != ok ]]; then
      add_issue "$chain_id" "$group:$target" "$probe_result at $address"
    fi
  done < <(configured_addresses "$chain_id")
}

dex_onchain_status() {
  local chain_id=$1 pairs=$2
  local pair field address probe_result
  local -a bad=()

  [[ -n $pairs ]] || { print -r -- "n/a"; return 0; }

  for pair in "${(@s:;:)pairs}"; do
    field=${pair%%=*}
    address=${pair#*=}
    [[ -n $field && -n $address ]] || continue
    code_state "$chain_id" "$address"
    probe_result=$code_state_result
    [[ $probe_result == ok ]] || bad+=("${field}:${probe_result}")
  done

  if (( ${#bad[@]} == 0 )); then
    print -r -- "ok"
  else
    print -r -- "${(j:, :)bad}"
  fi
}

append_dex_rows() {
  local chain_id=$1 dex dex_type solver config_state pairs onchain_state issue_text
  local chain_label=${chain_keys[$chain_id]:-$chain_id}

  while IFS=$'\t' read -r dex dex_type solver config_state pairs; do
    [[ -n $dex ]] || continue
    shared_dex_missing "$chain_id" "$dex" && continue
    onchain_state=$(dex_onchain_status "$chain_id" "$pairs")
    issue_text=""
    [[ $config_state == ok ]] || issue_text="config $config_state"
    if [[ $onchain_state != ok ]]; then
      [[ -n $issue_text ]] && issue_text+="; "
      issue_text+="onchain $onchain_state"
    fi
    [[ -n $issue_text ]] || issue_text="-"
    dex_rows+=("${chain_label}"$'\t'"${dex}"$'\t'"${dex_type}"$'\t'"${solver}"$'\t'"${issue_text}")
  done < <(dex_configs "$chain_id")
}

append_adapter_rows() {
  local chain_id=$1 solver adapter adapter_state issue_text
  local chain_label=${chain_keys[$chain_id]:-$chain_id}

  while IFS=$'\t' read -r solver adapter; do
    [[ -n $solver && -n $adapter ]] || continue
    code_state "$chain_id" "$adapter"
    adapter_state=$code_state_result
    if [[ $adapter_state == ok ]]; then
      issue_text="-"
    else
      issue_text="onchain $adapter_state"
    fi
    adapter_rows+=("${chain_label}"$'\t'"${solver}"$'\t'"${adapter}"$'\t'"${issue_text}")
  done < <(adapter_configs "$chain_id")
}

append_solver_coverage() {
  local chain_id=$1 chain_label=${chain_keys[$chain_id]:-$chain_id}
  local adapter_row row_chain row_solver row_adapter row_issue valid_count=0
  local -a solvers=()
  local solver_list

  for adapter_row in "${adapter_rows[@]}"; do
    IFS=$'\t' read -r row_chain row_solver row_adapter row_issue <<< "$adapter_row"
    [[ $row_chain == "$chain_label" ]] || continue
    [[ $row_issue == "-" ]] || continue
    solvers+=("$row_solver")
    (( ++valid_count ))
  done

  solver_list=${(j:,:)solvers}
  [[ -n $solver_list ]] || solver_list="-"
  coverage_rows+=("${chain_label}"$'\t'"${valid_count}"$'\t'"${solver_list}")
}

append_chain_data() {
  local chain_id=$1

  if ! chain "$chain_id" >/dev/null 2>&1; then
    add_issue "$chain_id" "onchain" "chain context failed"
    runtime_rows+=("${chain_keys[$chain_id]:-$chain_id}"$'\t'"$chain_id"$'\tunknown\tunknown\tunknown\tunknown\tunknown')
    return 0
  fi

  append_runtime_coverage "$chain_id"
  jq -e --arg id "$chain_id" 'has($id)' "$config" >/dev/null || return 0

  probe_chain "$chain_id"
  append_adapter_rows "$chain_id"
  append_solver_coverage "$chain_id"
  append_dex_rows "$chain_id"
}

append_runtime_coverage() {
  local chain_id=$1 field address oracle aggregator bound registered token quote
  local explicit=false core_count=0 adapter_count=0 adapter_total=0 oracle_count=0 oracle_total=0 price_count=0 price_total=0
  local spot_state=unsupported oracle_state=absent price_state=- core_bad=""
  jq -e --arg id "$chain_id" 'has($id)' "$config" >/dev/null && explicit=true
  if [[ $explicit == false && -n ${supported_chains[$chain_id]-} ]]; then
    add_issue "$chain_id" config "skill chain missing explicit config"
  fi

  while IFS=$'\t' read -r field address; do
    code_state "$chain_id" "$address"
    if [[ $code_state_result == ok ]]; then
      (( ++core_count ))
    else
      core_bad+=" $field:$code_state_result"
    fi
  done < <(jq -r --arg id "$chain_id" '. as $c | ["wm","repermit","cosigner","reactor","executor","refinery"][] as $f | [$f, ($c[$id][$f] // $c["*"][$f] // "-")] | @tsv' "$config")
  if [[ $explicit == true && $core_count != 6 ]]; then
    add_issue "$chain_id" core "$core_count/6;$core_bad"
  fi

  while IFS= read -r address; do
    [[ -n $address ]] || continue
    (( ++adapter_total ))
    code_state "$chain_id" "$address"
    [[ $code_state_result != ok ]] || (( ++adapter_count ))
  done < <(configured_addresses "$chain_id" | awk -F '\t' '$1 == "adapter" || ($1 == "dex" && $2 ~ /[.]adapter$/) { print tolower($3) }' | sort -u)
  if [[ $explicit == true ]] && (( core_count == 6 && adapter_count > 0 )); then
    spot_state=supported
    [[ -n ${supported_chains[$chain_id]-} ]] || add_issue "$chain_id" skill "supported deployment missing from skill chains"
  elif [[ $explicit == true || -n ${supported_chains[$chain_id]-} ]]; then
    (( adapter_count > 0 )) || add_issue "$chain_id" adapter-coverage "no deployed adapter (shared or chain-specific)"
  fi

  if print -r -- "$oracle_config" | jq -e --arg id "$chain_id" 'has($id)' >/dev/null; then
    oracle_state=configured
    if [[ $explicit == true || -n ${supported_chains[$chain_id]-} ]]; then
      oracle_state=ok
      while IFS=$'\t' read -r field address; do
        (( ++oracle_total ))
        code_state "$chain_id" "$address"
        if [[ $code_state_result == ok ]]; then
          (( ++oracle_count ))
        else
          oracle_state=failed
          add_issue "$chain_id" "oracle:$field" "$code_state_result at $address"
        fi
      done < <(print -r -- "$oracle_config" | jq -r --arg id "$chain_id" '.[$id] | (["oracle", (.oracle // "-")], ["aggregator", (.aggregator // "-")], (.adapters[]? | [(.label // .name), (.env.address // "-")])) | @tsv')
      if (( oracle_total < 3 )); then
        oracle_state=failed
        add_issue "$chain_id" oracle "no oracle adapters configured"
      fi
      if ! print -r -- "$oracle_config" | jq -e --arg id "$chain_id" '.[$id].connectors | type == "array" and all(.[]; type == "string" and test("^0x[0-9a-fA-F]{40}$"))' >/dev/null 2>&1; then
        oracle_state=failed
        add_issue "$chain_id" oracle "invalid connector list"
      fi
      oracle=$(print -r -- "$oracle_config" | jq -r --arg id "$chain_id" '.[$id].oracle // "-"')
      aggregator=$(print -r -- "$oracle_config" | jq -r --arg id "$chain_id" '.[$id].aggregator // "-"')
      if [[ $oracle_state == ok ]]; then
        bound=$(cast call "$oracle" 'aggregator()(address)' --rpc-timeout 15 2>/dev/null) || bound=""
        if [[ ${bound:l} != ${aggregator:l} ]]; then
          oracle_state=failed
          add_issue "$chain_id" oracle "aggregator binding mismatch or RPC failure"
        fi
        registered=$(cast call "$aggregator" 'oracles()(address[],uint8[])' --json --rpc-timeout 15 2>/dev/null) || registered='[]'
        while IFS= read -r address; do
          if ! print -r -- "$registered" | jq -e --arg addr "${address:l}" '.[0] | type == "array" and any(.[]; ascii_downcase == $addr)' >/dev/null 2>&1; then
            oracle_state=failed
            add_issue "$chain_id" oracle "adapter not registered: $address"
          fi
        done < <(print -r -- "$oracle_config" | jq -r --arg id "$chain_id" '.[$id].adapters[]?.env.address')
        while IFS= read -r token; do
          (( ++price_total ))
          quote=$(cast call "$oracle" 'usd(address)(uint256,uint8)' "$token" --json --rpc-timeout 15 2>/dev/null) || quote='[]'
          if print -r -- "$quote" | jq -e '.[0] | tostring | test("^[0-9]+$") and test("[1-9]")' >/dev/null 2>&1; then
            (( ++price_count ))
          else
            oracle_state=failed
            add_issue "$chain_id" oracle "USD quote failed or zero: $token"
          fi
        done < <(print -r -- "$oracle_config" | jq -r --arg id "$chain_id" --arg wrapped "${WETH:-}" '["0x0000000000000000000000000000000000000000", $wrapped, .[$id].connectors[]?] | unique[]')
        price_state="$price_count/$price_total"
      fi
      oracle_state+=" $oracle_count/$oracle_total"
    fi
  elif [[ $explicit == true || -n ${supported_chains[$chain_id]-} ]]; then
    add_issue "$chain_id" oracle "oracle config missing"
  fi
  runtime_rows+=("${chain_keys[$chain_id]:-$chain_id}"$'\t'"$chain_id"$'\t'"$spot_state"$'\t'"$core_count/6"$'\t'"$adapter_count/$adapter_total"$'\t'"$oracle_state"$'\t'"$price_state")
}

emit_chain_record() {
  local chain_id=$1 adapter_row dex_row coverage_row runtime_row issue

  append_chain_data "$chain_id"
  for runtime_row in "${runtime_rows[@]}"; do
    printf 'runtime\t%s\n' "$runtime_row"
  done
  for adapter_row in "${adapter_rows[@]}"; do
    printf 'adapter\t%s\n' "$adapter_row"
  done
  for dex_row in "${dex_rows[@]}"; do
    printf 'dex\t%s\n' "$dex_row"
  done
  for coverage_row in "${coverage_rows[@]}"; do
    printf 'coverage\t%s\n' "$coverage_row"
  done
  for issue in "${issue_rows[@]}"; do
    printf 'issue\t%s\n' "$issue"
  done
}

collect_chain_records() {
  local -a selected=("$@")

  if (( ${#selected[@]} == 1 )); then
    emit_chain_record "${selected[1]}"
    return 0
  fi

  command -v parallel >/dev/null 2>&1 || die 'parallel is required'
  SPOT_CONFIG_ROW_MODE=1 parallel --keep-order "$self" ::: "${selected[@]}"
}

collect_results() {
  local -a selected=("$@")
  local record kind payload
  local records
  records=$(collect_chain_records "${selected[@]}") || die 'chain checks failed to run'

  while IFS= read -r record; do
    [[ -n $record ]] || continue
    kind=${record%%$'\t'*}
    payload=${record#*$'\t'}
    case $kind in
      adapter) adapter_rows+=("$payload") ;;
      dex) dex_rows+=("$payload") ;;
      coverage) coverage_rows+=("$payload") ;;
      runtime) runtime_rows+=("$payload") ;;
      issue) issue_rows+=("$payload") ;;
    esac
  done <<< "$records"
}

print_solver_coverage() {
  {
    print "chain\tsolvers"
    printf '%s\n' "${coverage_rows[@]}" | sort -t $'\t' -k2,2n -k1,1 | awk -F '\t' '{ print $1 "\t" $3 }'
  } | print_table
}

print_integrations() {
  printf '%s\n' "${dex_rows[@]}" | awk -F '\t' -v supported_count=${#supported_order[@]} '
    NF >= 5 {
      key = $2 "\t" $3 "\t" $4
      if (!(key in seen)) {
        seen[key] = 1
        order[++count] = key
      }
      if (!chain_seen[key, $1]) {
        chains[key] = chains[key] ? chains[key] "," $1 : $1
        chain_seen[key, $1] = 1
        chain_count[key]++
      }
    }
    END {
      print "integration\ttype\tsolver\tchains"
      for (i = 1; i <= count; i++) {
        key = order[i]
        split(key, parts, "\t")
        print parts[1] "\t" parts[2] "\t" parts[3] "\t" (chain_count[key] == supported_count ? "all" : chains[key])
      }
    }
  ' | print_table
}

main() {
  local -a selected=()

  parse_args "$@"
  [[ -f $config ]] || die "config file not found: $config"
  [[ -f $skill_file ]] || die "skill file not found: $skill_file"
  command -v jq >/dev/null 2>&1 || die 'jq is required'
  command -v cast >/dev/null 2>&1 || die 'cast is required'
  command -v chain >/dev/null 2>&1 || die 'chain is required'
  if [[ -z $oracle_config ]]; then
    oracle_config=$(curl --fail --silent --show-error --max-time 30 https://raw.githubusercontent.com/orbs-network/offchain-oracle/master/config.json) || die 'cannot fetch production oracle config'
  fi
  print -r -- "$oracle_config" | jq -e 'type == "object" and length > 0 and all(keys[]; test("^[0-9]+$"))' >/dev/null || die 'invalid oracle config'
  export SPOT_ORACLE_CONFIG_JSON="$oracle_config"

  load_supported_chains
  load_chain_keys
  selected=("${(@f)$(selected_chains)}")

  if [[ ${SPOT_CONFIG_ROW_MODE:-} == 1 ]]; then
    (( ${#selected[@]} == 1 )) || die 'internal row mode requires exactly one chain'
    emit_chain_record "${selected[1]}"
    return 0
  fi

  collect_results "${selected[@]}"

  print "🔎 Spot / Oracle Coverage (core bytecode; oracle bytecode, registration, binding, USD quotes)"
  { print '#\tchain\tid\tSpot\tcore\tadapters deployed/known\toracle contracts\tUSD quotes'; printf '%s\n' "${runtime_rows[@]}" | sort -t $'\t' -k2,2n | awk '{ print NR "\t" $0 }'; } | print_table
  print 'Oracle-only chains are configuration references; live oracle checks apply to Spot chains.'
  print
  print "🔎 Solver Coverage"
  print_solver_coverage

  print
  print "🔎 Integrations"
  print_integrations

  if (( ${#issue_rows[@]} > 0 )); then
    print
    print "❌ Coverage failures"
    { print 'chain\tcheck\tdetail'; printf '%s\n' "${issue_rows[@]}"; } | print_table
    return 1
  fi
  print '✅ Spot core, execution, and oracle dependency checks passed.'
}

main "$@"
